# ==============================================================================
# ClassAll Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the required values.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
REGION=asia-southeast1
FIRESTORE_DATABASE=(default)
GCS_BUCKET=your-gcp-project-id-classall-docs
DOC_TASKS_TOPIC=doc-tasks
GMAIL_EVENTS_TOPIC=gmail-events

# ------------------------------------------------------------------------------
# Service URLs & Environment
# ------------------------------------------------------------------------------
APP_ENV=local
API_BASE_URL=http://localhost:8080
DASHBOARD_BASE_URL=http://localhost:3000
APP_SIGNING_SECRET=local-development-signing-secret

# ------------------------------------------------------------------------------
# Gemini / AI Models
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PRIMARY_MODEL=gemini-3.5-flash
FALLBACK_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Telegram Bot Integration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_UPLOADS_PER_HOUR=10

# ------------------------------------------------------------------------------
# Ingestion & Evaluation Security
# ------------------------------------------------------------------------------
GRADER_INGEST_KEY=

# ------------------------------------------------------------------------------
# Gmail Integration
# ------------------------------------------------------------------------------
GMAIL_OAUTH_CLIENT_JSON=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/oauth/callback
GMAIL_ADDRESS=
GMAIL_LABEL=INBOX
GMAIL_RECONCILE_SCHEDULE="0 * * * *"
GMAIL_RECONCILE_LIMIT=50

# ------------------------------------------------------------------------------
# Processing Limits & Leases
# ------------------------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
PROCESSING_LEASE_SECONDS=600

# ------------------------------------------------------------------------------
# Cloud Run Worker Internal Auth (Optional in local dev)
# ------------------------------------------------------------------------------
WORKER_AUTH_AUDIENCE=
WORKER_PUBSUB_INVOKER_EMAIL=
WORKER_SCHEDULER_INVOKER_EMAIL=
